// some while loop works properly with NetDust Runtime 1.2.6 or later.
// handle all operations with _native or arithmetic expressions

// --- const (pure)
room pi():
    return 3.141592653589793
end;
room e():
    return 2.718281828459045
end;
room tau():
    return 6.283185307179586
end;
room phi():
    return 1.618033988749895
end;
room sqrt2():
    return 1.4142135623730951
end;
room sqrt3():
    return 1.7320508075688772
end;

// --- C++ _native.
room pow(x, y):
    return _native.math_pow(x, y)
end;
room log(x):
    return _native.math_log(x)
end;
room log10(x):
    return _native.math_log10(x)
end;

// --- pure netdust
room abs(x):
    if (x < 0):
        return 0 - x
    end;
    return x
end;
room min(a, b):
    if (a < b):
        return a
    end;
    return b
end;
room max(a, b):
    if (a > b):
        return a
    end;
    return b
end;
room sign(x):
    if (x > 0):
        return 1
    end;
    if (x < 0):
        return -1
    end;
    return 0
end;

// --- pure netdust: floor / ceil / round

room floor(x):
    var f = x % 1
    var t = x - f
    if (f < 0):
        return t - 1
    end;
    return t
end;
room ceil(x):
    var f = x % 1
    var t = x - f
    if (f > 0):
        return t + 1
    end;
    return t
end;
room round(x):
    if (x >= 0):
        var r1 = call std.math.floor(x + 0.5)
        return r1
    end;
    var r2 = call std.math.ceil(x - 0.5)
    return r2
end;

// --- pure netdust: sqrt

room sqrt(x):
    if (x <= 0):
        return 0
    end;
    var g = (x + 1) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    g = (g + x / g) / 2
    return g
end;

// --- pure netdust: sin / cos / tan

room sin(x):
    var t = call std.math.tau()
    var kArg = x / t + 0.5
    var k = call std.math.floor(kArg)
    var xr = x - t * k
    var y = xr
    if (xr > 1.5707963267948966):
        y = 3.141592653589793 - xr
    end;
    if (xr < -1.5707963267948966):
        y = -3.141592653589793 - xr
    end;
    var y2 = y * y
    var y4 = y2 * y2
    var y6 = y4 * y2
    var y8 = y4 * y4
    var y10 = y8 * y2
    return y * (1 - y2 / 6 + y4 / 120 - y6 / 5040 + y8 / 362880 - y10 / 39916800)
end;
room cos(x):
    var s = call std.math.sin(x + 1.5707963267948966)
    return s
end;
room tan(x):
    var s = call std.math.sin(x)
    var c = call std.math.cos(x)
    return s / c
end;

room clamp(v, lo, hi):
    if (v < lo):
        return lo
    end;
    if (v > hi):
        return hi
    end;
    return v
end;
room lerp(a, b, t):
    return a + (b - a) * t
end;
room hypot(a, b):
    var h = call std.math.sqrt(a * a + b * b)
    return h
end;
room deg(r):
    return r * 57.29577951308232
end;
room rad(d):
    return d * 0.017453292519943295
end;
room map(v, a1, b1, a2, b2):
    return a2 + (v - a1) * (b2 - a2) / (b1 - a1)
end;

// factorial recommended: n <= 20 (to prevent overflow)
room factorial(n):
    var absN = call std.math.abs(n)
    var an = call std.math.floor(absN)
    var r = 1
    if (an >= 2):
        for(i in 2..an+1):
            r = r * i
        end;
    end;
    return r
end;

room gcd(a, b):
    var absA = call std.math.abs(a)
    var ia = call std.math.floor(absA)
    var absB = call std.math.abs(b)
    var ib = call std.math.floor(absB)
    while(ib != 0):
        var r = ia % ib
        ia = ib
        ib = r
    end;
    return ia
end;

room lcm(a, b):
    var absA = call std.math.abs(a)
    var ia = call std.math.floor(absA)
    var absB = call std.math.abs(b)
    var ib = call std.math.floor(absB)
    var g = call std.math.gcd(ia, ib)
    var q = ia / g
    var fq = call std.math.floor(q)
    var result = fq * ib
    return result
end;
