code start

// works properly with NetDust Runtime 1.2.6 or later.

var lilium_title = "Lilium"
var lilium_message = ""

room notification.title(text):
    lilium_title = text
    return lilium_title
end;

room notification.message(text):
    lilium_message = text
    return lilium_message
end;

room notification.show(shouldShow):
    if(shouldShow == "false"):
        return "false"
    end;
    return _native.notify_send(lilium_title, lilium_message)
end;
